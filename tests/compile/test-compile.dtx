% \selectlanguage{ngerman}
%
% \section{Grundlegende Test für die Artikelklasse}
%
% Die Grundlegenden Tests der Artikelklasse soll gewährleisten,
% dass diese bei Änderung von Interna oder beim testen gegen eine
% andere TeXLive Distribution nicht mehr kompiliert.
%
% Dafür werden die einzelnen unterstützten Komponenten
% der Artikelklasse in jeweils einzelnen Testdokumenten genutzt.
%
% \subsection{Entpacken der Tests}
%
% Um eine Dokumentation der Tests zu gewährleisten, werden die Tests
% mittels \dpkg{docstrip} entpackt und erst dann getestet.
%
% Um die generierung der Testdatei und die Docstrip-Anweisung nah beieinander zu haben
% wird ein Hilfsbefehl deklariert
%
%    \begin{macrocode}
%<*ins>
\input docstrip.tex
\def\tudcdbatchfilemode{\relax}
%</ins>
%    \end{macrocode}
%
% \subsection{Kompilationstests}
%
% Diese Folge an Test ist genau dann erfolgreich, wenn die Kompilation
% ohne Fehler abbricht und eine PDF generiert.
%
% Mit dem folgenden Guard wird die bereitgestellte Testsuite von \dpkg{l3build}
% in alle Tests dieser Suite eingebunden.
% Da die Batchdatei zum erstellen des Tests zerstückelt geschrieben wird,
% müssen Guards um die Präambel der Tests geschrieben werden.
%    \begin{macrocode}
%<*ins>
\ifx\tudcdbatchfilemode\undefined%
%</ins>
%<*preamble>
\input{regression-test.tex}
%</preamble>
%<*ins>
\fi
%</ins>
%    \end{macrocode}
%
% \begin{unittest}{dev-version}{Kompilation der Artikelklasse}
%
% In dem ersten Test wird eine erfolgreiche Kompilation der Artikelklasse
% getestet.
%
%    \begin{macrocode}
%<*ins>
\generate{\file{\jobname-0001.lvt}{\from{\jobname.dtx}{0001,preamble}}}
%</ins>
%    \end{macrocode}
% Und dies ohne jegliche zusätzliche Pakete.
%    \begin{macrocode}
%<*ins>
\ifx\tudcdbatchfilemode\undefined%
%</ins>
%<*0001>
\documentclass{tudcdartcl}

\begin{document}
Hallo Welt!
\end{document}
%</0001>
%<*ins>
\fi
%</ins>
%    \end{macrocode}
%
% \end{unittest}
%
